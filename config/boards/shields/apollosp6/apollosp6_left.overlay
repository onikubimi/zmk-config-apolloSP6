#include "apollosp6.dtsi"

&kscan0 {
        diode-direction = "row2col";
        row-gpios
            = <&gpio1 1  (GPIO_ACTIVE_LOW)>   // R0 006
            , <&gpio1 1  (GPIO_ACTIVE_LOW)>   // R1 008
            , <&gpio1 1  (GPIO_ACTIVE_LOW)>   // R2 100
            , <&gpio1 1  (GPIO_ACTIVE_LOW)>   // R3 011
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R4 104
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // R5 106

        col-gpios
           = <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C0 017
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C1 020
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C2 022
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C3 024
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C4 009
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C5 010
           , <&gpio1  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // C6 111
           , <&gpio1 13 GPIO_ACTIVE_HIGH>  // C7 113
           , <&gpio1 15 GPIO_ACTIVE_HIGH>  // C8 115
           , <&gpio0  2 GPIO_ACTIVE_HIGH>  // C9 002
           , <&gpio0 29 GPIO_ACTIVE_HIGH>; // C10 029
};
