#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  125   35       0     0     0>  // 1
            , <&key_physical_attrs 100 100  225    0       0     0     0>  // 2
            , <&key_physical_attrs 100 100  325 (-25)      0     0     0>  // 3
            , <&key_physical_attrs 100 100  425    0       0     0     0>  // 4
            , <&key_physical_attrs 100 100  525   25       0     0     0>  // 5
            , <&key_physical_attrs 100 100  950   25       0     0     0>  // 6
            , <&key_physical_attrs 100 100 1050    0       0     0     0>  // 7
            , <&key_physical_attrs 100 100 1150 (-25)      0     0     0>  // 8
            , <&key_physical_attrs 100 100 1250    0       0     0     0>  // 9
            , <&key_physical_attrs 100 100 1350   35       0     0     0>  // 0

            , <&key_physical_attrs 100 100    0  125       0     0     0>  // Esc
            , <&key_physical_attrs 100 100  125  175       0     0     0>  // Q
            , <&key_physical_attrs 100 100  225  125       0     0     0>  // W
            , <&key_physical_attrs 100 100  325  100       0     0     0>  // E
            , <&key_physical_attrs 100 100  425  125       0     0     0>  // R
            , <&key_physical_attrs 100 100  525  150       0     0     0>  // T
            , <&key_physical_attrs 100 100  950  150       0     0     0>  // Y
            , <&key_physical_attrs 100 100 1050  125       0     0     0>  // U
            , <&key_physical_attrs 100 100 1150  100       0     0     0>  // I
            , <&key_physical_attrs 100 100 1250  125       0     0     0>  // O
            , <&key_physical_attrs 100 100 1350  175       0     0     0>  // P
            , <&key_physical_attrs 100 100 1485  125       0     0     0>  // Bksp

            , <&key_physical_attrs 100 100    0  225       0     0     0>  // Caps
            , <&key_physical_attrs 100 100  125  275       0     0     0>  // A
            , <&key_physical_attrs 100 100  225  225       0     0     0>  // S
            , <&key_physical_attrs 100 100  325  200       0     0     0>  // D
            , <&key_physical_attrs 100 100  425  225       0     0     0>  // F
            , <&key_physical_attrs 100 100  525  250       0     0     0>  // G
            , <&key_physical_attrs 100 100  660  300       0     0     0>  // Bksp
            , <&key_physical_attrs 100 100  815  300       0     0     0>  // M0
            , <&key_physical_attrs 100 100  950  250       0     0     0>  // H
            , <&key_physical_attrs 100 100 1050  225       0     0     0>  // J
            , <&key_physical_attrs 100 100 1150  200       0     0     0>  // K
            , <&key_physical_attrs 100 100 1250  225       0     0     0>  // L
            , <&key_physical_attrs 100 100 1350  275       0     0     0>  // ]
            , <&key_physical_attrs 100 100 1485  225       0     0     0>  // -

            , <&key_physical_attrs 100 100    0  325       0     0     0>  // Shift
            , <&key_physical_attrs 100 100  225  325       0     0     0>  // Z
            , <&key_physical_attrs 100 100  325  300       0     0     0>  // X
            , <&key_physical_attrs 100 100  425  325       0     0     0>  // C
            , <&key_physical_attrs 100 100  525  350       0     0     0>  // V
            , <&key_physical_attrs 100 100  660  400       0     0     0>  // Enter
            , <&key_physical_attrs 100 100  815  400       0     0     0>  // M1
            , <&key_physical_attrs 100 100  950  350       0     0     0>  // B
            , <&key_physical_attrs 100 100 1050  325       0     0     0>  // N
            , <&key_physical_attrs 100 100 1150  300       0     0     0>  // M
            , <&key_physical_attrs 100 100 1250  325       0     0     0>  // [
            , <&key_physical_attrs 100 100 1485  325       0     0     0>  // Enter

            , <&key_physical_attrs 100 100   15  471       0     0     0>  // ◀
            , <&key_physical_attrs 100 100  115  400       0     0     0>  // ▲
            , <&key_physical_attrs 100 100  115  496       0     0     0>  // ▼
            , <&key_physical_attrs 100 100  215  475       0     0     0>  // ▶
            , <&key_physical_attrs 100 100  325  470       0     0     0>  // Ctrl
            , <&key_physical_attrs 100 100  435  475    1000     0     0>  // Tab
            , <&key_physical_attrs 100 100  545  495    2000     0     0>  // Alt
            , <&key_physical_attrs 100 100  655  535    3000     0     0>  // ␣
            , <&key_physical_attrs 100 100  820  570 (-3000)     0     0>  // 無
            , <&key_physical_attrs 100 100  930  510 (-2000)     0     0>  // Win
            , <&key_physical_attrs 100 100 1040  472 (-1000)     0     0>  // ,
            , <&key_physical_attrs 100 100 1150  475       0     0     0>  // .
            , <&key_physical_attrs 100 100 1265  467       0     0     0>  // ◀
            , <&key_physical_attrs 100 100 1365  495       0     0     0>  // ▼
            , <&key_physical_attrs 100 100 1365  395       0     0     0>  // ▲
            , <&key_physical_attrs 100 100 1465  471       0     0     0>; // ▶
    };



    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                    RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                    RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                    RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)                    RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)          RC(3,15)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)    RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R0 006
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R1 008
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R2 100
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R3 011
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R4 104
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // R5 106
    };



    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        status = "okay";
    };

};



