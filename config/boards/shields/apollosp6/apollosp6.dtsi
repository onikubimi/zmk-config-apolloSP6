#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  100   35       0     0     0> // [0,1] 6
            , <&key_physical_attrs 100 100  200    0       0     0     0> // [0,2] 7
            , <&key_physical_attrs 100 100  300  -25       0     0     0> // [0,3] 8
            , <&key_physical_attrs 100 100  400    0       0     0     0> // [0,4] 9
            , <&key_physical_attrs 100 100  500   25       0     0     0> // [0,5] 0

            , <&key_physical_attrs 100 100  880   25       0     0     0> // [0,8] 6
            , <&key_physical_attrs 100 100  980    0       0     0     0> // [0,9] 7
            , <&key_physical_attrs 100 100 1080  -25       0     0     0> // [0,10] 8
            , <&key_physical_attrs 100 100 1180    0       0     0     0> // [0,11] 9
            , <&key_physical_attrs 100 100 1280   25       0     0     0> // [0,12] 0

            /* Row 1 */
            , <&key_physical_attrs 100 100    0  100       0     0     0> // [1,0] Esc
            , <&key_physical_attrs 100 100  100  135       0     0     0> // [1,1] Q
            , <&key_physical_attrs 100 100  200  100       0     0     0> // [1,2] W
            , <&key_physical_attrs 100 100  300   75       0     0     0> // [1,3] E
            , <&key_physical_attrs 100 100  400  100       0     0     0> // [1,4] R
            , <&key_physical_attrs 100 100  500  125       0     0     0> // [1,5] T

            , <&key_physical_attrs 100 100  765  125       0     0     0> // [1,7] - / M0
            , <&key_physical_attrs 100 100  880  125       0     0     0> // [1,8] Y
            , <&key_physical_attrs 100 100  980  100       0     0     0> // [1,9] U
            , <&key_physical_attrs 100 100 1080   75       0     0     0> // [1,10] I
            , <&key_physical_attrs 100 100 1180  100       0     0     0> // [1,11] O
            , <&key_physical_attrs 100 100 1280  125       0     0     0> // [1,12] P
            , <&key_physical_attrs 100 100 1380  100       0     0     0> // [1,13] Bksp

            /* Row 2 */
            , <&key_physical_attrs 100 100    0  200       0     0     0> // [2,0] Caps
            , <&key_physical_attrs 100 100  100  235       0     0     0> // [2,1] A
            , <&key_physical_attrs 100 100  200  200       0     0     0> // [2,2] S
            , <&key_physical_attrs 100 100  300  175       0     0     0> // [2,3] D
            , <&key_physical_attrs 100 100  400  200       0     0     0> // [2,4] F
            , <&key_physical_attrs 100 100  500  225       0     0     0> // [2,5] G
            , <&key_physical_attrs 100 100  615  225       0     0     0> // [2,6] Bksp

            , <&key_physical_attrs 100 100  765  225       0     0     0> // [2,7] / / M1
            , <&key_physical_attrs 100 100  880  225       0     0     0> // [2,8] H
            , <&key_physical_attrs 100 100  980  200       0     0     0> // [2,9] J
            , <&key_physical_attrs 100 100 1080  175       0     0     0> // [2,10] K
            , <&key_physical_attrs 100 100 1180  200       0     0     0> // [2,11] L
            , <&key_physical_attrs 100 100 1280  225       0     0     0> // [2,12] ▲
            , <&key_physical_attrs 100 100 1380  200       0     0     0> // [2,13] Enter

            /* Row 3 */
            , <&key_physical_attrs 100 100    0  300       0     0     0> // [3,0] Shift
            , <&key_physical_attrs 100 100  100  335       0     0     0> // [3,1] ▲
            , <&key_physical_attrs 100 100  200  300       0     0     0> // [3,2] ▼
            , <&key_physical_attrs 100 100  300  275       0     0     0> // [3,3] Z
            , <&key_physical_attrs 100 100  400  300       0     0     0> // [3,4] ▶
            , <&key_physical_attrs 100 100  500  325       0     0     0> // [3,5] 
            , <&key_physical_attrs 100 100  615  325       0     0     0> // [3,6] Enter

            , <&key_physical_attrs 100 100  880  325       0     0     0> // [3,8] B
            , <&key_physical_attrs 100 100  980  300       0     0     0> // [3,9] N
            , <&key_physical_attrs 100 100 1080  275       0     0     0> // [3,10] M
            , <&key_physical_attrs 100 100 1180  300       0     0     0> // [3,11] ◀
            , <&key_physical_attrs 100 100 1280  325       0     0     0> // [3,12] ▼
            , <&key_physical_attrs 100 100 1380  300       0     0     0> // [3,13] ▶

            /* Row 4: 親指・下段クラスター */
            , <&key_physical_attrs 100 100    0  400       0     0     0> // [4,0] ◀
            , <&key_physical_attrs 100 100  100  435       0     0     0> // [4,1] ▼
            , <&key_physical_attrs 100 100  200  400       0     0     0> // [4,2] ▶
            , <&key_physical_attrs 100 100  300  450     (0)     0     0> // [4,3] Ctrl
            , <&key_physical_attrs 100 100  410  455  (1000)     0     0> // [4,4] Tab
            , <&key_physical_attrs 100 100  520  475  (2000)     0     0> // [4,5] Alt
            , <&key_physical_attrs 100 100  630  515  (3000)     0     0> // [4,6] space / fn1

            , <&key_physical_attrs 100 100  760  560 (-3000)     0     0> // [4,7] 無 / fn2
            , <&key_physical_attrs 100 100  865  500 (-2000)     0     0> // [4,8] Win
            , <&key_physical_attrs 100 100  970  468 (-1000)     0     0> // [4,9] . / *
            , <&key_physical_attrs 100 100 1080  450     (0)     0     0>; // [4,10] +
    };


    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                    RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                    RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                    RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)                    RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)          RC(3,15)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)    RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R0 006
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R1 008
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R2 100
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R3 011
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R4 104
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // R5 106
    };



    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        status = "okay";
    };

};



