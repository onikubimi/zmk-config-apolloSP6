#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  125   75       0     0     0>
            , <&key_physical_attrs 100 100  225   25       0     0     0>
            , <&key_physical_attrs 100 100  325    0       0     0     0>
            , <&key_physical_attrs 100 100  425   25       0     0     0>
            , <&key_physical_attrs 100 100  525   50       0     0     0>
            , <&key_physical_attrs 100 100  950   50       0     0     0>
            , <&key_physical_attrs 100 100 1050   25       0     0     0>
            , <&key_physical_attrs 100 100 1150    0       0     0     0>
            , <&key_physical_attrs 100 100 1250   25       0     0     0>
            , <&key_physical_attrs 100 100 1350   75       0     0     0>
            , <&key_physical_attrs 100 100    0  125       0     0     0>
            , <&key_physical_attrs 100 100  125  175       0     0     0>
            , <&key_physical_attrs 100 100  225  125       0     0     0>
            , <&key_physical_attrs 100 100  325  100       0     0     0>
            , <&key_physical_attrs 100 100  425  125       0     0     0>
            , <&key_physical_attrs 100 100  525  150       0     0     0>
            , <&key_physical_attrs 100 100  950  150       0     0     0>
            , <&key_physical_attrs 100 100 1050  125       0     0     0>
            , <&key_physical_attrs 100 100 1150  100       0     0     0>
            , <&key_physical_attrs 100 100 1250  125       0     0     0>
            , <&key_physical_attrs 100 100 1350  175       0     0     0>
            , <&key_physical_attrs 100 100 1485  125       0     0     0>
            , <&key_physical_attrs 100 100    0  225       0     0     0>
            , <&key_physical_attrs 100 100  125  275       0     0     0>
            , <&key_physical_attrs 100 100  225  225       0     0     0>
            , <&key_physical_attrs 100 100  325  200       0     0     0>
            , <&key_physical_attrs 100 100  425  225       0     0     0>
            , <&key_physical_attrs 100 100  525  250       0     0     0>
            , <&key_physical_attrs 100 100  660  300       0     0     0>
            , <&key_physical_attrs 100 100  815  300       0     0     0>
            , <&key_physical_attrs 100 100  950  250       0     0     0>
            , <&key_physical_attrs 100 100 1050  225       0     0     0>
            , <&key_physical_attrs 100 100 1150  200       0     0     0>
            , <&key_physical_attrs 100 100 1250  225       0     0     0>
            , <&key_physical_attrs 100 100 1350  275       0     0     0>
            , <&key_physical_attrs 100 100 1485  225       0     0     0>
            , <&key_physical_attrs 100 100    0  325       0     0     0>
            , <&key_physical_attrs 100 100  225  325       0     0     0>
            , <&key_physical_attrs 100 100  325  300       0     0     0>
            , <&key_physical_attrs 100 100  425  325       0     0     0>
            , <&key_physical_attrs 100 100  525  350       0     0     0>
            , <&key_physical_attrs 100 100  660  400       0     0     0>
            , <&key_physical_attrs 100 100  815  400       0     0     0>
            , <&key_physical_attrs 100 100  950  350       0     0     0>
            , <&key_physical_attrs 100 100 1050  325       0     0     0>
            , <&key_physical_attrs 100 100 1150  300       0     0     0>
            , <&key_physical_attrs 100 100 1250  325       0     0     0>
            , <&key_physical_attrs 100 100 1485  325       0     0     0>
            , <&key_physical_attrs 100 100   15  471       0     0     0>
            , <&key_physical_attrs 100 100  115  400       0     0     0>
            , <&key_physical_attrs 100 100  115  496       0     0     0>
            , <&key_physical_attrs 100 100  215  475       0     0     0>
            , <&key_physical_attrs 100 100  325  470       0     0     0>
            , <&key_physical_attrs 100 100  520  390    1000     0     0>
            , <&key_physical_attrs 100 100  695  275    2000     0     0>
            , <&key_physical_attrs 100 100  850  135    3000     0     0>
            , <&key_physical_attrs 100 100  425  921 (-3000)     0     0>
            , <&key_physical_attrs 100 100  690  815 (-2000)     0     0>
            , <&key_physical_attrs 100 100  935  665 (-1000)     0     0>
            , <&key_physical_attrs 100 100 1150  475       0     0     0>
            , <&key_physical_attrs 100 100 1265  467       0     0     0>
            , <&key_physical_attrs 100 100 1365  495       0     0     0>
            , <&key_physical_attrs 100 100 1365  395       0     0     0>
            , <&key_physical_attrs 100 100 1465  471       0     0     0>
            ;
    };


    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <5>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                    RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                    RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                    RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)                    RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)          RC(3,15)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)    RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };



    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        status = "okay";
    };

};



