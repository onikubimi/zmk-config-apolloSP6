#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
            keys  //                 w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  100   35       0     0     0> // 1
            , <&key_physical_attrs 100 100  200 (-15)      0     0     0> // 2
            , <&key_physical_attrs 100 100  300 (-40)      0     0     0> // 3
            , <&key_physical_attrs 100 100  400 (-15)      0     0     0> // 4
            , <&key_physical_attrs 100 100  500   10       0     0     0> // 5
            , <&key_physical_attrs 100 100  925   10       0     0     0> // 6
            , <&key_physical_attrs 100 100 1025 (-15)      0     0     0> // 7
            , <&key_physical_attrs 100 100 1125 (-40)      0     0     0> // 8
            , <&key_physical_attrs 100 100 1225 (-15)      0     0     0> // 9
            , <&key_physical_attrs 100 100 1325   35       0     0     0> // 0

            , <&key_physical_attrs 100 100  -25   85       0     0     0> // Esc
            , <&key_physical_attrs 100 100  100  135       0     0     0> // Q
            , <&key_physical_attrs 100 100  200   85       0     0     0> // W
            , <&key_physical_attrs 100 100  300   60       0     0     0> // E
            , <&key_physical_attrs 100 100  400   85       0     0     0> // R
            , <&key_physical_attrs 100 100  500  110       0     0     0> // T
            , <&key_physical_attrs 100 100  925  110       0     0     0> // Y
            , <&key_physical_attrs 100 100 1025   85       0     0     0> // U
            , <&key_physical_attrs 100 100 1125   60       0     0     0> // I
            , <&key_physical_attrs 100 100 1225   85       0     0     0> // O
            , <&key_physical_attrs 100 100 1325  135       0     0     0> // P
            , <&key_physical_attrs 100 100 1460   85       0     0     0> // Bksp

            , <&key_physical_attrs 100 100  -25  185       0     0     0> // Caps
            , <&key_physical_attrs 100 100  100  235       0     0     0> // A
            , <&key_physical_attrs 100 100  200  185       0     0     0> // S
            , <&key_physical_attrs 100 100  300  160       0     0     0> // D
            , <&key_physical_attrs 100 100  400  185       0     0     0> // F
            , <&key_physical_attrs 100 100  500  210       0     0     0> // G
            , <&key_physical_attrs 100 100  635  260       0     0     0> // Bksp (中央)
            , <&key_physical_attrs 100 100  790  260       0     0     0> // / (M0)
            , <&key_physical_attrs 100 100  925  210       0     0     0> // H
            , <&key_physical_attrs 100 100 1025  185       0     0     0> // J
            , <&key_physical_attrs 100 100 1125  160       0     0     0> // K
            , <&key_physical_attrs 100 100 1225  185       0     0     0> // L
            , <&key_physical_attrs 100 100 1325  235       0     0     0> // ]
            , <&key_physical_attrs 100 100 1460  185       0     0     0> // -

            , <&key_physical_attrs 100 100  -25  285       0     0     0> // Shift
            , <&key_physical_attrs 100 100  200  285       0     0     0> // Z
            , <&key_physical_attrs 100 100  300  260       0     0     0> // X
            , <&key_physical_attrs 100 100  400  285       0     0     0> // C
            , <&key_physical_attrs 100 100  500  310       0     0     0> // V
            , <&key_physical_attrs 100 100  635  360       0     0     0> // Enter (中央)
            , <&key_physical_attrs 100 100  790  360       0     0     0> // \ (M1)
            , <&key_physical_attrs 100 100  925  310       0     0     0> // B
            , <&key_physical_attrs 100 100 1025  285       0     0     0> // N
            , <&key_physical_attrs 100 100 1125  260       0     0     0> // M
            , <&key_physical_attrs 100 100 1225  285       0     0     0> // [
            , <&key_physical_attrs 100 100 1460  285       0     0     0> // Enter

            , <&key_physical_attrs 100 100  -10  431       0     0     0> // ◀
            , <&key_physical_attrs 100 100   90  360       0     0     0> // ▲
            , <&key_physical_attrs 100 100   90  456       0     0     0> // ▼
            , <&key_physical_attrs 100 100  190  435       0     0     0> // ▶
            , <&key_physical_attrs 100 100  300  430       0     0     0> // Ctrl
            , <&key_physical_attrs 100 100  495  350   (1000)    0     0> // Tab
            , <&key_physical_attrs 100 100  670  235   (2000)    0     0> // Alt
            , <&key_physical_attrs 100 100  825   95   (3000)    0     0> // space / fn1
            , <&key_physical_attrs 100 100  400  881  (-3000)    0     0> // 無変換 / fn2
            , <&key_physical_attrs 100 100  665  775  (-2000)    0     0> // Win
            , <&key_physical_attrs 100 100  910  625  (-1000)    0     0> // ,
            , <&key_physical_attrs 100 100 1125  435       0     0     0> // .
            , <&key_physical_attrs 100 100 1240  427       0     0     0> // ◀
            , <&key_physical_attrs 100 100 1340  455       0     0     0> // ▼
            , <&key_physical_attrs 100 100 1340  355       0     0     0> // ▲
            , <&key_physical_attrs 100 100 1440  431       0     0     0>; // ▶
    };



    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                    RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                    RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                    RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)                    RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)          RC(3,15)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)    RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R0 006
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R1 008
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R2 100
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R3 011
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R4 104
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // R5 106
    };



    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        status = "okay";
    };

};



