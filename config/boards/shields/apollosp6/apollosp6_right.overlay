#include "apollosp6.dtsi"

&default_transform {
    col-offset = <8>;
};

&kscan0 {
        diode-direction = "col2row";
        row-gpios
            = <&gpio0  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R0 006
            , <&gpio0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R1 008
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R2 113
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R3 011
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R4 104
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // R5 106

         col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>   // 列8  (右手一番内側：M0 / M1 の列)
            , <&gpio0 29 GPIO_ACTIVE_HIGH>   // 列9  (6 / Y / H / B の列)  ← ここにRC(2,9)のピンを入れる
            , <&gpio0  2 GPIO_ACTIVE_HIGH>   // 列10 (7 / U / J / N の列)  ← ここにRC(2,10)のピンを入れる
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   // 列11 (8 / I / K / M の列)
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   // 列12 (9 / O / L / [ の列)
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   // 列13 (0 / P / ] の列)
            , <&gpio0 20 GPIO_ACTIVE_HIGH>   // 列14 (Bksp / - / Enter の列)
            , <&gpio0 17 GPIO_ACTIVE_HIGH>;  // 列15 (右端の列)
};
